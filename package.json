{
  "name": "localbridge-monorepo",
  "version": "1.4.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Secure Model Context Protocol (MCP) Bridge for Local Development",
  "homepage": "https://github.com/ysunyang4/Nexus",
  "repository": {
    "type": "git",
    "url": "https://github.com/ysunyang4/Nexus.git"
  },
  "bugs": {
    "url": "https://github.com/ysunyang4/Nexus/issues"
  },
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* run build && pnpm --filter=@localbridge/server run build && pnpm --filter=@localbridge/runner run build && pnpm --filter=@localbridge/desktop run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run tests/tools-compliance.test.ts apps/bridge/tests/all-80-mcp-tools-contract.test.ts apps/bridge/tests/tools-compliance.test.ts",
    "test:all": "vitest run",
    "test:watch": "vitest",
    "dev:server": "pnpm --filter @localbridge/server dev",
    "dev:runner": "pnpm --filter @localbridge/runner dev",
    "bundle:runtime": "tsx scripts/prepare-bundled-resources.ts",
    "verify:resources": "tsx scripts/verify-bundled-resources.ts",
    "site:preview": "node scripts/serve-website.js",
    "clean": "pnpm -r run clean"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "@types/node": "^22.13.4",
    "@types/ws": "^8.5.14",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "tsup": "^8.3.6",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6",
    "ws": "^8.18.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ],
    "overrides": {
      "@modelcontextprotocol/sdk": ">=1.32.2",
      "zod": "^4.6.7",
      "body-parser": "^2.4.0",
      "tinypool": ">=2.1.2",
      "basic-ftp": ">=6.2.1",
      "source-map-js": ">=1.2.1",
      "hono": ">=4.13.16",
      "@hono/node-server": ">=2.1.3",
      "qs": ">=6.16.1",
      "fastify": ">=5.12.6",
      "ip-address": ">=10.7.4",
      "fast-uri": ">=4.2.3"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7",
    "yaml": "^2.9.1"
  }
}
