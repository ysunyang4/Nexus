{
  "manifest_version": 3,
  "name": "Nexus Extension Bridge Pro",
  "version": "1.3.4",
  "description": "Enterprise Multi-Model Relay Gateway & Sub-Process Task Executor for Nexus LocalBridge",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "alarms",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "http://localhost:*/*",
    "http://127.0.0.1:*/*",
    "ws://localhost:*/*",
    "ws://127.0.0.1:*/*",
    "*://*.openai.com/*",
    "*://*.chatgpt.com/*",
    "*://chatgpt.com/*",
    "*://*.claude.ai/*",
    "*://claude.ai/*",
    "*://*.deepseek.com/*",
    "*://deepseek.com/*",
    "*://*.kimi.com/*",
    "*://kimi.com/*",
    "*://*.kimi.moonshot.cn/*",
    "*://kimi.moonshot.cn/*",
    "*://*.moonshot.cn/*",
    "*://*.doubao.com/*",
    "*://doubao.com/*",
    "*://*.duckduckgo.com/*",
    "*://duckduckgo.com/*",
    "*://*.duck.ai/*",
    "*://duck.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://chatgpt.com/*",
        "*://*.chatgpt.com/*",
        "*://chat.openai.com/*",
        "*://claude.ai/*",
        "*://*.claude.ai/*",
        "*://chat.deepseek.com/*",
        "*://*.deepseek.com/*",
        "*://kimi.com/*",
        "*://*.kimi.com/*",
        "*://kimi.moonshot.cn/*",
        "*://*.kimi.moonshot.cn/*",
        "*://doubao.com/*",
        "*://*.doubao.com/*",
        "*://duckduckgo.com/*",
        "*://*.duckduckgo.com/*",
        "*://duck.ai/*",
        "*://*.duck.ai/*"
      ],
      "js": [
        "adapters/base-adapter.js",
        "adapters/chatgpt-adapter.js",
        "adapters/claude-adapter.js",
        "adapters/deepseek-adapter.js",
        "adapters/kimi-adapter.js",
        "adapters/doubao-adapter.js",
        "adapters/duck-adapter.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon-64.png"
  },
  "icons": {
    "64": "icons/icon-64.png",
    "128": "icons/icon-128.png"
  }
}
